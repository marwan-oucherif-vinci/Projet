###
# PATCH /users/{id}/reactivate Admin reactivate a user not activated -> 200
PATCH http://localhost:3000/users/7/reactivate
Authorization: {{admin_login.response.body.token}}


###
# PATCH /users/{id}/reactivate no token -> 401
PATCH http://localhost:3000/users/7/reactivate

###
# PATCH /users/{id}/reactivate Authentificated user is not an admin -> 403
PATCH http://localhost:3000/users/7/reactivate
Authorization: {{player_login.response.body.token}}

###
# PATCH /users/{id}/reactivate Authentificated user is not an admin -> 403
PATCH http://localhost:3000/users/7/reactivate
Authorization: {{referee_login.response.body.token}}


###
# PATCH /users/{id}/reactivate user not found -> 404
PATCH http://localhost:3000/users/9999/reactivate
Authorization: {{admin_login.response.body.token}}



