###
# admin update a field but not found -> 404
PUT http://localhost:3000/fields/999
Authorization: {{admin_login.response.body.token}}
Content-Type: application/json

{
    "id" : 999,
    "name": "Mrnnn",
    "location": "scucusuu"
}