### token's generation
# log as administrator
# @name admin_login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
   "username": "admin",
   "password": "admin"
}

### log as player
# @name player_login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
   "username": "player",
   "password": "player"
}

### log as referee
# @name referee_login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
   "username": "ref",
   "password": "ref"
}

### log as trainer
# @name trainer_login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
   "username": "trainer",
   "password": "trainer"
}



###
# GET All teams ( no auth required )
GET http://localhost:3000/teams/

### --------------------------------------------------------------------


###
# POST /teams - Trainer -> 201
POST http://localhost:3000/teams/
Authorization: {{trainer_login.response.body.token}}
Content-Type: application/json

{
  "name": "Red Dragons",
  "description": "A competitive football team",
  "sportType": "football"
}

###
# POST /teams - inalid or missing fields -> 400
POST http://localhost:3000/teams/
Authorization: {{trainer_login.response.body.token}}
Content-Type: application/json

{
  "description": "A competitive football team",
  "sportType": "football"
}

###
# POST /teams - no tokern -> 401
POST http://localhost:3000/teams/
Content-Type: application/json

{
  "name": "Red Dragons",
  "description": "A competitive football team",
  "sportType": "football"
}

###
# POST /teams - Authentificated User is not a trainer -> 403
POST http://localhost:3000/teams/
Authorization: {{player_login.response.body.token}}
Content-Type: application/json

{
  "name": "Red Dragons",
  "description": "A competitive football team",
  "sportType": "football"
}

###
# POST /teams - Authentificated User is not a trainer -> 403
POST http://localhost:3000/teams/
Authorization: {{admin_login.response.body.token}}
Content-Type: application/json

{
  "name": "Red Dragons",
  "description": "A competitive football team",
  "sportType": "football"
}

###
# POST /teams - team name already exists
POST http://localhost:3000/teams/
Authorization: {{trainer_login.response.body.token}}
Content-Type: application/json

{
  "name": "Red Dragons",
  "description": "A competitive football team",
  "sportType": "football"
}

### -----------------------------------------------------------------------

###
# GET /teams/own - Get teams, Any auth user (player ) -> 200
GET http://localhost:3000/teams/own
Authorization: {{player_login.response.body.token}}

###
# GET /teams/own - Get teams for a referee  (200)
GET http://localhost:3000/teams/own
Authorization: {{referee_login.response.body.token}}

###
# GET /teams/own - Get teams for a admin (200)
GET http://localhost:3000/teams/own
Authorization: {{admin_login.response.body.token}}

###
# GET /teams/own - Get teams for a trainer (200)
GET http://localhost:3000/teams/own
Authorization: {{trainer_login.response.body.token}}

###
# GET /teams/own - No token -> 401
GET http://localhost:3000/teams/own

### ----------------------------------------------------------------------------

###
# GET a team with an id correct -> 200
GET http://localhost:3000/teams/1

###
# GET a team with an id not valid -> 400
GET http://localhost:3000/teams/1EZAEAZ

###
# GET a team with no team with that ID exists. -> 404
GET http://localhost:3000/teams/999

### -------------------------------------------------------------------------

###
# PUT trainer update an team and he's the trainer of this team  -> 200
PUT http://localhost:3000/teams/1
Authorization: {{trainer_login.response.body.token}}
Content-Type : application/json

{
  "id": 1,
  "name": "Larwab FC",
  "description": "Siu",
  "sportType": "caca",
  "players": [
      2,
      3,
      10
    ],
  "trainerId": 6 
}


###
# PUT trainer update an team with invalid id -> 400
PUT http://localhost:3000/teams/eaz
Authorization: {{trainer_login.response.body.token}}
Content-Type : application/json

{
  "id": 1,
  "name": "Red Dragons FC",
  "description": "Updated description",
  "sportType": "football",
  "players": [
      2,
      3,
      10
    ],
  "trainerId": 5
}

###
# PUT trainer update an team with invalid payload -> 400
PUT http://localhost:3000/teams/1
Authorization: {{trainer_login.response.body.token}}
Content-Type : application/json

{
  "sportType": "football",
  "players": [
      2,
      3,
      10
    ],
  "trainerId": 5
}


