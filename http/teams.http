###
# PATCH Any authentificated user ( trainer here ) join a team -> 200
PATCH http://localhost:3000/teams/3/join
Authorization: {{trainer_login.response.body.token}}

###
# PATCH Any authentificated user ( trainer here ) join a team but already in-> 400
PATCH http://localhost:3000/teams/3/join
Authorization: {{trainer_login.response.body.token}}


###
# PATCH Any authentificated user ( player here ) join a team -> 200
PATCH http://localhost:3000/teams/2/join
Authorization: {{player_login.response.body.token}}

###
# PATCH Any authentificated user ( player here ) join a team but already in-> 400
PATCH http://localhost:3000/teams/2/join
Authorization: {{player_login.response.body.token}}


###
# PATCH no token join a team -> 401
PATCH http://localhost:3000/teams/2/join


###
# PATCH join a team that doesn't exist ( not found ) -> 404
PATCH http://localhost:3000/teams/444/join
Authorization: {{player_login.response.body.token}}



###
# PATCH TRAINER can't leave his team -> 403
PATCH http://localhost:3000/teams/1/leave
Authorization: {{trainer_login.response.body.token}}

###
# PATCH Any authentificated user ( player here ) leave his team -> 200
PATCH http://localhost:3000/teams/2/leave
Authorization: {{player_login.response.body.token}}

###
# PATCH Any authentificated user ( player here ) leave a team but not a member-> 404
PATCH http://localhost:3000/teams/2/leave
Authorization: {{player_login.response.body.token}}


###
# PATCH no token leave a team -> 401
PATCH http://localhost:3000/teams/2/leave


###
# PATCH leave a team that doesn't exist ( not found ) -> 404
PATCH http://localhost:3000/teams/444/leave
Authorization: {{player_login.response.body.token}}









